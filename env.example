# mailcow Logs Viewer Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# Your mailcow instance URL (without trailing slash)
MAILCOW_URL=https://mail.example.com

# mailcow API key - Read-Only (generate in mailcow admin under
# System → Configuration → Access → Administrators → API)
# Required permissions: Read access to logs
# In mailcow the key must be active, and its allowed IPs must include the
# address this app connects from (see documentation/ENV_Settings.md)
MAILCOW_API_KEY=your-api-key-here

# mailcow API key - Read-Write (optional, for actions such as quarantine,
# queue, Fail2Ban, rate limits and Rspamd maps)
# Generate a separate key with write permissions under
# System → Configuration → Access → Administrators → API.
# Its allowed IPs must also include the address this app connects from.
# MAILCOW_API_KEY_RW=your-rw-api-key-here

# App time zone, an IANA name such as Europe/Berlin (UTC when unset; also editable in Settings > Application)
# TZ=Europe/Berlin

# How dates and times are written (also editable in Settings > Application):
# browser (default), DD/MM/YYYY, MM/DD/YYYY, DD.MM.YYYY or YYYY-MM-DD; 24h (default), 12h or browser
# DATE_FORMAT=DD/MM/YYYY
# TIME_FORMAT=24h

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# These settings cannot be changed via the web UI and must be set here

# PostgreSQL credentials
POSTGRES_USER=mailcowlogs
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mailcowlogs

# Database host (use 'db' for docker-compose setup)
POSTGRES_HOST=db

# Database port
POSTGRES_PORT=5432

# =============================================================================
# SETTINGS UI CONFIGURATION
# =============================================================================
# Allow editing app settings from the web UI (Settings page). When enabled,
# values saved in the UI are stored in the database. A variable that is set
# in ENV still wins and shows locked in the UI (priority: Default → DB → ENV).
# Use "Migrate Settings from ENV" in the UI to copy the current config into
# the database, then remove from ENV the variables you want to manage from
# the website. MAILCOW_URL, MAILCOW_API_KEY and the POSTGRES_* variables must
# stay here: the app does not start without them.
# Default: false (all configuration from ENV only)
# IMPORTANT: Must be in .env (or docker-compose environment). After a change,
# run docker compose up -d; a restart does not read .env again.
SETTINGS_EDIT_VIA_UI_ENABLED=true

# =============================================================================
# NOTE: All other settings can be configured via the web UI
# =============================================================================
# When SETTINGS_EDIT_VIA_UI_ENABLED=true, you can manage all other settings
# from the Settings tab in the web interface. See documentation/ENV_Settings.md
# for a complete reference of all available environment variables.
